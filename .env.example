APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Zona horaria de la app y de la sesion de PostgreSQL (Bolivia, UTC-4)
APP_TIMEZONE=America/La_Paz

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# --- Servidor de correo del Helpdesk (inyección de dependencias) ---
# Opciones: gmail | smtp | log
HELPDESK_MAIL_DRIVER=smtp
FRONTEND_URL=http://localhost:5173

# Driver "gmail": cuenta de Google + Contraseña de aplicación (verificación en 2 pasos)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_ADDRESS=

# Driver "smtp": servidor propio del cliente. Si se dejan vacías se usan las MAIL_* de arriba.
HELPDESK_SMTP_HOST=
HELPDESK_SMTP_PORT=587
HELPDESK_SMTP_ENCRYPTION=tls
HELPDESK_SMTP_USERNAME=
HELPDESK_SMTP_PASSWORD=
HELPDESK_SMTP_FROM_ADDRESS=

# Recepcion de respuestas por correo (IMAP). Valores: gmail | imap | none
# Con gmail/imap, programar: php artisan schedule:work  (o el Programador de tareas de Windows)
HELPDESK_INBOUND_DRIVER=none
# Direccion del buzon (Reply-To de los correos). Por defecto, el usuario IMAP.
HELPDESK_INBOUND_ADDRESS=
HELPDESK_INBOUND_LOOKBACK_DAYS=3
HELPDESK_INBOUND_SUBJECT_FILTER=TCK-
HELPDESK_INBOUND_MARK_AS_READ=true
# Solo para el driver imap (usuario/clave caen a HELPDESK_SMTP_* / MAIL_*)
HELPDESK_IMAP_HOST=
HELPDESK_IMAP_PORT=993
HELPDESK_IMAP_ENCRYPTION=ssl
HELPDESK_IMAP_VALIDATE_CERT=true
HELPDESK_IMAP_USERNAME=
HELPDESK_IMAP_PASSWORD=
HELPDESK_IMAP_FOLDER=INBOX

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
